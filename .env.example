# ローカル SAST/SCA 用の環境変数テンプレート。
# compose/security.yml が参照する。実値は .env にコピーして設定する（.env は追跡しない）。

# SonarQube アクセストークン（SonarQube 起動後に My Account > Security > Generate Tokens で発行）
SONAR_TOKEN=

# SonarQube Web UI ポート（既定 9000。競合する場合は変更）
SONARQUBE_PORT=9000

# SonarQube バックエンド PostgreSQL（ローカル開発用。本番では強固な値に変更）
POSTGRES_DB=sonar
POSTGRES_USER=sonar
POSTGRES_PASSWORD=sonar

# examples/ の LLM プロバイダ切り替え（examples/_shared/_azure.py が参照）。
# "azure"（既定）| "openai"。課金を OpenAI 側へ分けたいときは "openai" にする
# （コマンド単位なら EXAMPLES_LLM_PROVIDER=openai uv run python examples/... でも可）
EXAMPLES_LLM_PROVIDER=azure

# Azure OpenAI（examples/ 実行用。Responses API。examples/_azure.py が参照）
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
# "preview" で Microsoft v1 preview エンドポイント（Responses API）。dated 版も可
AZURE_OPENAI_API_VERSION=preview
AZURE_OPENAI_DEPLOYMENT=

# Azure OpenAI Realtime（examples/realtime/handoff_session.py 実行用。WebSocket 接続）。
# Realtime 用モデル（例: gpt-4o-realtime-preview）のデプロイ名。Responses 用の
# AZURE_OPENAI_DEPLOYMENT とは別デプロイ。未設定なら OPENAI_API_KEY にフォールバックする
AZURE_OPENAI_REALTIME_DEPLOYMENT=

# OpenAI 直接続（EXAMPLES_LLM_PROVIDER=openai のとき必須。examples/realtime の
# フォールバックとしても使用）
OPENAI_API_KEY=
# OpenAI 直接続時のモデル名（EXAMPLES_LLM_PROVIDER=openai のとき必須。例: gpt-5.4-mini）
OPENAI_MODEL=
# OpenAI 直接続のエンドポイント上書き（任意。未設定なら https://api.openai.com/v1）。
# openai SDK 標準の環境変数で、プロキシ / 互換ゲートウェイ利用時のみ設定する
# OPENAI_BASE_URL=
# API スタイル（任意。既定 "responses"）。litellm 等 Responses API 非対応の
# 互換ゲートウェイでは "chat_completions" にする。rollout のモデルクラス選択と
# APO gradient / apply-edit の apo_api（examples の api_style() 経由）の両方に効く
# OPENAI_API_STYLE=responses

# 会話履歴 db の保存先（任意・CLI serve 用）。設定するとそのフォルダ直下に
# conversations.db を作る（例: XDG_DATA_HOME=./data なら ./data/conversations.db）。
# 未設定なら既定の ./memory/conversations.db。serve --session-db <path> が最優先。
# XDG_DATA_HOME=

# Langfuse（examples/llmops/04 の観測連携用。oai-agentspec[llmops-langfuse]）。
# 稼働中の Langfuse インスタンス（self-host / cloud）の認証情報。未設定なら 04 は実行時に
# 案内を出して終了する（01-03 の採点 example は Langfuse 不要）。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 接続先 URL。self-host 例: http://localhost:3000 / cloud 例: https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== マネージド Fine-Tuning（examples/finetune/ 用。oai-agentspec[finetune]）=====
# データセット整形・検証・会話ログ生成の example（01-05 / 09）は API 接続を伴わないため
# env なしで実行できる。
# 以下はジョブ投入を伴う example（06 = SFT / 07 = DPO / 08 = tools つき SFT・DPO）のための設定。

# --- 学習対象モデル（メソッドごとに指定する。デプロイ名ではなくモデル名）---
# SFT 用（06_submit_job_live.py / 08 の既定）。例: gpt-4.1-mini-2025-04-14
FINETUNE_SFT_BASE_MODEL=
# DPO 用（07_submit_dpo_job_live.py / 08 の --method dpo）。DPO 対応モデルは SFT より狭い。
# SFT の成果物へ DPO を重ねる場合は 06 が返した model_ref（ft:... 形式）を設定する
FINETUNE_DPO_BASE_MODEL=

# --- FT 共通の設定 ---
# FT ジョブ API の接続先（任意。"azure" | "openai"）。EXAMPLES_LLM_PROVIDER の FT 版で、
# 「推論は OpenAI 互換ゲートウェイ・FT は Azure」のような構成を扱うために独立して指定できる。
# 未設定なら AZURE_OPENAI_FINETUNE_ENDPOINT があれば azure、無ければ EXAMPLES_LLM_PROVIDER
# FINETUNE_PROVIDER=
# 学習実行方式（Azure の training type。任意・**Azure 専用**・未設定なら送信しない）。
# OpenAI 直接続（FINETUNE_PROVIDER=openai）では未知フィールドとして拒否されるため、
# 設定されていても examples は送信しない。
# 学習コストに直結する: Developer が最安（データレジデンシー保証なし・スポット容量のため
# プリエンプトあり）、GlobalStandard は regional standard より低廉。値は検証せず透過する
# ため、表記ゆれ（Developer / developer 等）で 400 が返る場合は別表記を試す
FINETUNE_TRAINING_TYPE=
# FT ジョブ API の api-version（任意・未設定なら 2025-04-01-preview）。
# 推論用の AZURE_OPENAI_API_VERSION は継承しない: trainingType の指定は公式手順が
# dated 版を要求するため。v1 preview 方式（/openai/v1/ 系統）を試す場合は preview を指定する
# AZURE_OPENAI_FINETUNE_API_VERSION=

# --- FT 用の接続オーバーライド（すべて任意）---
# fine-tuning が使えるリージョンは限られるため、推論用リソースが FT 非対応リージョンにある
# 場合や、課金・権限を分けたい場合に設定する。未設定なら推論用の設定へフォールバックする
# ので、同一リソースで済むなら何も設定しなくてよい。
# 【重要】接続先を分けたら API キーも必ず分けて設定する。エンドポイント / base_url は推論用
# から継承しないのに API キーは継承するため、キーだけ未設定にすると推論用のキーが別ホストへ
# 送信される（例: 推論を OpenAI 互換ゲートウェイへ向けている構成で OPENAI_FINETUNE_API_KEY を
# 設定しないと、ゲートウェイの仮想キーが api.openai.com へ送られる）。
# FT ジョブ API のエンドポイント（未設定なら AZURE_OPENAI_ENDPOINT）
# AZURE_OPENAI_FINETUNE_ENDPOINT=
# FT ジョブ API のキー（未設定なら AZURE_OPENAI_API_KEY）
# AZURE_OPENAI_FINETUNE_API_KEY=
# OpenAI 直接続で FT のキーを分ける場合（未設定なら OPENAI_API_KEY）
# OPENAI_FINETUNE_API_KEY=
# OpenAI 直接続で FT の接続先を指定する（未設定なら https://api.openai.com/v1）。
# 推論用の OPENAI_BASE_URL は継承しない: chat 専用ゲートウェイ等は Files / fine_tuning API を
# 持たず 404 になるため
# OPENAI_FINETUNE_BASE_URL=
